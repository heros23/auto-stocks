# Frontend polling / cache
WATCHLIST_POLL_SECONDS=30
GROUP_REFRESH_MIN_SECONDS=60
SEARCH_CLICK_DEBOUNCE_MS=1200
CHART_CACHE_SECONDS=300
ACCOUNT_POLL_SECONDS=5

# Backend response cache
SCAN_CACHE_TTL_SECONDS=15
GROUP_SCAN_CACHE_TTL_SECONDS=30
CHART_CACHE_TTL_SECONDS=300
ACCOUNT_CACHE_TTL_SECONDS=5
LLM_STRATEGY_CACHE_TTL_SECONDS=900
REQUEST_DEDUP_WINDOW_MS=1500
MAX_PARALLEL_GROUP_SCANS=2
COMPRESS_RESPONSE_FIELDS=true
DROP_UNUSED_FIELDS=volume_0d,volume_1d,week52_high,week52_low,currency

# LLM token budget
LLM_PRIMARY_MODEL=gpt-4.1-mini
LLM_FALLBACK_MODEL=gpt-4.1-nano
LLM_TEMPERATURE=0.2
LLM_MAX_INPUT_CHARS=4000
LLM_MAX_OUTPUT_TOKENS=600
LLM_SUMMARY_OUTPUT_TOKENS=180
LLM_TOP_N_SYMBOLS_FOR_REASONING=12
LLM_REUSE_DAILY_MARKET_SUMMARY=true
LLM_CACHE_KEY_DIMS=market,preset,period,pct,session_date
